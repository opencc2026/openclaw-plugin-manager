{
  "plugins": [
    {
      "id": "feishu-doc",
      "name": "飞书文档",
      "version": "1.2.0",
      "description": "飞书文档读写操作技能，支持文档创建、编辑、分享等功能",
      "categories": ["productivity", "office", "collaboration"],
      "keywords": ["feishu", "document", "office", "collaboration"],
      "author": "OpenClaw Team",
      "homepage": "https://github.com/openclaw/feishu-doc",
      "recommended": true,
      "installation": "通过clawhub安装: clawhub install feishu-doc",
      "configTemplate": {
        "appId": "your_app_id",
        "appSecret": "your_app_secret",
        "defaultSpace": "personal"
      },
      "configGuide": {
        "questions": [
          {
            "type": "input",
            "name": "appId",
            "message": "请输入飞书应用ID:"
          },
          {
            "type": "password",
            "name": "appSecret",
            "message": "请输入飞书应用密钥:"
          }
        ],
        "mapping": [
          {
            "question": "appId",
            "key": "appId"
          },
          {
            "question": "appSecret",
            "key": "appSecret"
          }
        ]
      }
    },
    {
